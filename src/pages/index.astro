---
import { url } from '../lib/url';
import { Image } from 'astro:assets';
import PostList from '../components/PostList.astro';
import { CATEGORIES, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../lib/posts';

const allPosts = await getPublishedPosts();
const posts = allPosts.slice(0, 3);
// 카테고리마다 최신 글 3개씩 묶어 보여 준다 (잡지형 첫 화면)
const sections = CATEGORIES.map((c) => ({
	...c,
	posts: allPosts.filter((p) => p.data.category === c.slug).slice(0, 3),
})).filter((c) => c.posts.length > 0);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<section class="intro">
		<h1>{SITE_TITLE}</h1>
		<p>{SITE_DESCRIPTION}</p>
	</section>

	<section class="categories">
		{
			CATEGORIES.map((c) => (
				<a href={url(`/category/${c.slug}`)}>
					<strong>{c.name}</strong>
					<span>{c.description}</span>
				</a>
			))
		}
	</section>

	<section>
		<h2>최신 글</h2>
		<PostList posts={posts} />
		<p class="more"><a href={url('/blog')}>전체 글 보기 →</a></p>
	</section>

	{
		sections.map((c) => (
			<section class="cat-section">
				<div class="cat-head">
					<h2>{c.name}</h2>
					<a href={url(`/category/${c.slug}`)}>더 보기 →</a>
				</div>
				<ul class="cards">
					{c.posts.map((p) => (
						<li>
							<a href={url(`/blog/${p.id}/`)}>
								{p.data.heroImage && (
									<Image width={480} height={270} src={p.data.heroImage} alt={p.data.heroAlt ?? p.data.title} />
								)}
								<span>{p.data.title}</span>
							</a>
						</li>
					))}
				</ul>
			</section>
		))
	}
</BaseLayout>

<style>
	.intro h1 {
		margin-bottom: 0.3em;
	}
	.intro p {
		color: rgb(var(--gray));
	}
	.categories {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
		gap: 0.8em;
		margin: 2em 0 1em;
	}
	.categories a {
		display: flex;
		flex-direction: column;
		padding: 1em 1.1em;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 10px;
		text-decoration: none;
		color: inherit;
		transition:
			border-color 0.2s ease,
			box-shadow 0.2s ease;
	}
	.categories a:hover {
		border-color: var(--accent);
		box-shadow: var(--box-shadow);
	}
	.categories strong {
		color: rgb(var(--black));
	}
	.categories span {
		font-size: 0.8em;
		color: rgb(var(--gray));
		line-height: 1.6;
	}
	@media (max-width: 720px) {
		.categories {
			grid-template-columns: 1fr 1fr;
			gap: 0.5em;
		}
		.categories a {
			padding: 0.6em 0.8em;
			font-size: 0.9em;
		}
		.categories span {
			display: none;
		}
	}
	.more {
		margin-top: 1.5em;
		text-align: right;
	}
	.cat-section {
		margin-top: 2.5em;
		padding-top: 1.5em;
		border-top: 1px solid rgb(var(--gray-light));
	}
	.cat-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1em;
	}
	.cat-head h2 {
		margin: 0 0 0.6em;
		font-size: 1.4em;
	}
	.cat-head a {
		font-size: 0.85em;
		white-space: nowrap;
	}
	.cards {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1em;
	}
	.cards a {
		display: block;
		text-decoration: none;
		color: rgb(var(--black));
	}
	.cards img {
		width: 100%;
		height: auto;
		border-radius: 8px;
		margin-bottom: 0.5em;
	}
	.cards span {
		display: block;
		font-size: 0.95em;
		font-weight: 600;
		line-height: 1.45;
	}
	.cards a:hover span {
		color: var(--accent);
	}
	@media (max-width: 720px) {
		.cards {
			grid-template-columns: 1fr;
		}
	}
</style>
