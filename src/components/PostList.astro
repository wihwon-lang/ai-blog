---
// 글 목록 카드 (홈·전체 글·카테고리 페이지 공용)
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { getCategory } from '../consts';
import FormattedDate from './FormattedDate.astro';

interface Props {
	posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;
---

{
	posts.length === 0 ? (
		<p class="empty">아직 글이 없습니다. 곧 올라옵니다.</p>
	) : (
		<ul>
			{posts.map((post) => (
				<li>
					<a href={`/blog/${post.id}/`}>
						{post.data.heroImage && (
							<Image width={720} height={405} src={post.data.heroImage} alt="" />
						)}
						<span class="category">{getCategory(post.data.category).name}</span>
						<h3 class="title">{post.data.title}</h3>
						<p class="description">{post.data.description}</p>
						<p class="date">
							<FormattedDate date={post.data.pubDate} />
						</p>
					</a>
				</li>
			))}
		</ul>
	)
}

<style>
	ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	li {
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	a {
		display: block;
		padding: 1.4em 0;
		text-decoration: none;
		color: inherit;
	}
	img {
		margin-bottom: 0.8em;
	}
	.category {
		font-size: 0.8em;
		font-weight: 600;
		color: var(--accent);
	}
	.title {
		margin: 0.2em 0 0.3em;
		font-size: 1.25em;
		transition: color 0.2s ease;
	}
	a:hover .title {
		color: var(--accent);
	}
	.description {
		margin: 0 0 0.4em;
		color: rgb(var(--gray));
		font-size: 0.92em;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.date {
		margin: 0;
		color: rgb(var(--gray));
		font-size: 0.8em;
	}
	.empty {
		color: rgb(var(--gray));
	}
</style>
